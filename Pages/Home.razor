
@page "/"
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using WolfNET.Game
@using WolfNET.Graphics

@inject BlazorJSRuntime JS
@inject HttpClient Http

@inject RendererSettings Settings
@inject WebGpuRenderer  Renderer
@inject Wolf Wolf

@implements IDisposable

<canvas @ref="_canvas"
        width="@Settings.Width"
        height="@Settings.Height"
        style="width: @(Settings.Width)px; height: @(Settings.Height)px;"
        tabindex="0">
</canvas>

<aside class="map-switcher" aria-label="Map selection">
    <nav aria-label="Maps">
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == OriginalMap))"
                aria-pressed="@(_selectedMap == OriginalMap ? "true" : "false")" @onclick="() => SelectMapAsync(OriginalMap)">Original</button>
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == ShowcaseMap))"
                aria-pressed="@(_selectedMap == ShowcaseMap ? "true" : "false")" @onclick="() => SelectMapAsync(ShowcaseMap)">Showcase</button>
    </nav>
    <p role="status">@(_loading ? "Loading map…" : "Click the game to capture the mouse. Esc releases it.")</p>
    @if (_selectedMap == ShowcaseMap)
    {
        <ul class="showcase-guide">
            <li><strong>Top right:</strong> different floors, ceilings, and four wall faces.</li>
            <li><strong>Top left:</strong> lanes from left: clear path, invisible barrier, walk-through wall, solid wall.</li>
            <li><strong>Bottom right:</strong> sprites and groups; some block movement or visibility.</li>
            <li><strong>Bottom left:</strong> missing textures. Pink is intentional.</li>
        </ul>
    }
    <p class="controls-hint">W/S move · Q/E strafe · A/D or mouse turn</p>
</aside>

@if (_error != null)
{
    <pre class="game-error">@_error</pre>
}

@code {
    private ElementReference _canvas;
    private HTMLCanvasElement? _canvasElement;
    private readonly CancellationTokenSource _lifetime = new();
    private const string OriginalMap = "maps/level1.json";
    private const string ShowcaseMap = "maps/showcase.json";
    private string? _selectedMap;
    private bool _loading = true;
    private bool _disposed;
    private bool _errorPresent => _error != null;

    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Console.WriteLine("[APP] Component initialized");

        try
        {
            Console.WriteLine("[APP] Loading shader");

            var computeShader = await Http.GetStringAsync(
                "shaders/raycast.wgsl");

            var wallsShader = await Http.GetStringAsync(
                "shaders/walls.wgsl");

            var spritesShader = await Http.GetStringAsync(
                "shaders/sprites.wgsl");

            Console.WriteLine(
                $"[APP] Shader loaded");

            _canvasElement = new HTMLCanvasElement(_canvas);

            await Renderer.InitializeAsync(_canvasElement, computeShader, wallsShader, spritesShader);

            await Wolf.StartAsync(_canvasElement, _lifetime.Token);
            _selectedMap = OriginalMap;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = ex.ToString();

            Console.Error.WriteLine(
                $"[APP] Initialization failed: {ex}");

            StateHasChanged();
        }
        finally
        {
            _loading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SelectMapAsync(string mapPath)
    {
        if (_loading || _disposed || _canvasElement == null) return;
        _loading = true;
        _error = null;
        try
        {
            await Wolf.SwitchMapAsync(_canvasElement, mapPath, _lifetime.Token);
            _selectedMap = mapPath;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = $"Could not load map: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        Wolf.Stop();
        _canvasElement?.Dispose();
        Console.WriteLine("[APP] Disposing");
    }
}
