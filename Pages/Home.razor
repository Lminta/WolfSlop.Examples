
@page "/"

@using WolfNET.Graphics
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using WolfNET.Game

@inject BlazorJSRuntime JS
@inject HttpClient Http

@inject RendererSettings Settings
@inject WebGpuRenderer  Renderer
@inject Wolf Wolf

@implements IDisposable

<canvas @ref="_canvas"
        width="@Settings.Width"
        height="@Settings.Height"
        style="width: @(Settings.Width)px; height: @(Settings.Height)px;"
        tabindex="0">
</canvas>

@if (_error != null)
{
    <pre class="game-error">@_error</pre>
}

@code {
    private ElementReference _canvas;

    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Console.WriteLine("[APP] Component initialized");

        try
        {
            Console.WriteLine("[APP] Loading shader");

            string shader = await Http.GetStringAsync(
                "shaders/screen.wgsl");

            Console.WriteLine(
                $"[APP] Shader loaded: {shader.Length} chars");

            using var canvas = new HTMLCanvasElement(_canvas);
            
            await Renderer.InitializeAsync(
                canvas,
                shader);
            
            Wolf.Start();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();

            Console.Error.WriteLine(
                $"[APP] Initialization failed: {ex}");

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Console.WriteLine("[APP] Disposing");
    }
}
