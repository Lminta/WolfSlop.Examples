<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedPlatform>browser</SupportedPlatform>
    <Description>Reusable WebGPU raycasting, tile worlds, scenes, input, physics and audio for .NET applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="SpawnDev.BlazorJS" Version="3.5.30" />
    <InternalsVisibleTo Include="WolfNET.MapTests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
