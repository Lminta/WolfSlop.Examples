@using WolfNET.Game
@implements IDisposable
@inject Wolf Wolf

@if (_state is { ThirdPerson: false } state)
{
    <div class="player-hands" aria-hidden="true">
        <img class="player-hand player-hand-left" src="textures/characters/first-person-hands.png" alt="" draggable="false"
             style="@HandTransform(state, left: true)" />
        <img class="player-hand player-hand-right" src="textures/characters/first-person-hands.png" alt="" draggable="false"
             style="@HandTransform(state, left: false)" />
    </div>
}

@code {
    private HumanViewState? _state;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _state = Wolf.HumanState;
        Wolf.HumanStateChanged += OnHumanStateChanged;
    }

    private static string HandTransform(HumanViewState state, bool left)
    {
        var side = left ? -1 : 1;
        var swing = state.HandSwing * side;
        var x = swing * .7f - state.HandStrafe * 1.2f;
        var y = swing * 1.8f + state.HandBob * .7f + (state.InAir ? -4 : state.Crouching ? 3 : 0);
        var rotation = swing * 3 + state.HandStrafe * 2 + (state.InAir ? side * -5 : 0);
        if (!left)
        {
            x -= state.HandReach * 5;
            y -= state.HandReach * 8;
            rotation -= state.HandReach * 12;
        }
        return FormattableString.Invariant($"transform: translate({x:0.###}cqw, {y:0.###}cqh) rotate({rotation:0.###}deg);");
    }

    private void OnHumanStateChanged(HumanViewState state)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _state = state;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Wolf.HumanStateChanged -= OnHumanStateChanged;
    }
}
