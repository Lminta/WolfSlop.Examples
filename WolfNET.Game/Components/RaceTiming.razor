@using WolfNET.Game
@using System.Globalization
@implements IDisposable
@inject Wolf Wolf

@if (_state is { } race)
{
    <dl class="race-timing" aria-label="Lap counter and race timers">
        <div><dt>Laps</dt><dd class="race-laps">@race.CompletedLaps</dd></div>
        <div><dt>Total</dt><dd class="race-total">@Time(race.TotalMilliseconds)</dd></div>
        <div><dt>Lap</dt><dd class="race-lap">@Time(race.LapMilliseconds)</dd></div>
        <div><dt>Last</dt><dd class="race-last">@(race.LastLapMilliseconds is { } last ? Time(last) : "—")</dd></div>
    </dl>
}

@code {
    private RaceStatus? _state;
    private bool _disposed;

    private static string Time(double milliseconds)
    {
        var centiseconds = (long)(milliseconds / 10);
        return string.Create(CultureInfo.InvariantCulture, $"{centiseconds / 6000}:{centiseconds / 100 % 60:00}.{centiseconds % 100:00}");
    }

    protected override void OnInitialized()
    {
        _state = Wolf.RaceState;
        Wolf.RaceStateChanged += OnRaceStateChanged;
    }

    private void OnRaceStateChanged(RaceStatus state)
    {
        if (_disposed || _state == state) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _state = state;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Wolf.RaceStateChanged -= OnRaceStateChanged;
    }
}
