@page "/"
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using WolfNET.Game
@using WolfNET.Game.InputEvents
@using WolfNET.Graphics

@inject BlazorJSRuntime JS
@inject HttpClient Http

@inject RendererSettings Settings
@inject WebGpuRenderer  Renderer
@inject Wolf Wolf

@implements IDisposable

<canvas @ref="_canvas"
        width="@Settings.Width"
        height="@Settings.Height"
        style="--render-width: @Settings.Width; --render-height: @Settings.Height;"
        tabindex="0">
</canvas>

@if (_loading)
{
    <div class="loading-overlay" role="status" aria-live="polite" aria-atomic="true">
        <div class="loading-card">
            <div class="loading-spinner" aria-hidden="true"></div>
            <h1>Loading scene</h1>
            <p>@_loadingMessage</p>
        </div>
    </div>
}

<aside class="map-switcher" aria-label="Map selection">
    <nav aria-label="Maps">
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == OriginalMap))"
                aria-pressed="@(_selectedMap == OriginalMap ? "true" : "false")" @onclick="() => SelectMapAsync(OriginalMap)">Original</button>
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == ShowcaseMap))"
                aria-pressed="@(_selectedMap == ShowcaseMap ? "true" : "false")" @onclick="() => SelectMapAsync(ShowcaseMap)">Showcase</button>
    </nav>
    <p role="status">@(_loading ? _loadingMessage : _observedMouse?.CaptureError ?? "Click the game to capture the mouse. Esc releases it.")</p>
    @if (_selectedMap == ShowcaseMap)
    {
        <ul class="showcase-guide">
            <li><strong>Top right:</strong> different floors, ceilings, and four wall faces.</li>
            <li><strong>Top left:</strong> lanes from left: clear path, invisible barrier, walk-through wall, solid wall. All have textured floors and ceilings.</li>
            <li><strong>Bottom right:</strong> props and a barrel pyramid are grouped on the west side. The clear east side has two jumpable rows of four columns at 0.4 scale near (9,20), with room to approach and land.</li>
            <li><strong>Obstacle corridor:</strong> enter through (24,11) from the independent-flags gallery. Follow the loop, alternating Space to jump and Alt to crouch.</li>
            <li><strong>Crouch test:</strong> hold Alt to pass under the ceiling-mounted columns at (9,16). Release after clearing them to stand.</li>
            <li><strong>Bottom left:</strong> missing textures. Pink is intentional.</li>
            <li><strong>Far left annex:</strong> enter from the fallback gallery to compare a mesh ceiling with open sky. Walk around the enlarged car at (30,18) to see its eight directional views.</li>
        </ul>
    }
    <p class="controls-hint">W/S forward/back &middot; A/D strafe &middot; Mouse look &middot; Space jump &middot; Alt crouch &middot; Esc release</p>
</aside>

@if (_error != null)
{
    <pre class="game-error">@_error</pre>
}

@code {
    [SupplyParameterFromQuery(Name = "map")]
    public string? RequestedMap { get; set; }

    private ElementReference _canvas;
    private HTMLCanvasElement? _canvasElement;
    private readonly CancellationTokenSource _lifetime = new();
    private const string OriginalMap = "maps/level1.json";
    private const string ShowcaseMap = "maps/showcase.json";
    private string? _selectedMap;
    private bool _loading = true;
    private string _loadingMessage = "Loading shaders…";
    private bool _disposed;
    private bool _errorPresent => _error != null;

    private string? _error;
    private MouseTracker? _observedMouse;

    private async Task ShowLoadingProgressAsync(string message)
    {
        _lifetime.Token.ThrowIfCancellationRequested();
        _loadingMessage = message;
        await InvokeAsync(StateHasChanged);
        // Allow the browser to paint the message before the next loading step.
        await Task.Delay(1, _lifetime.Token);
    }

    private void ObserveMouse()
    {
        if (_observedMouse != null) _observedMouse.CaptureStateChanged -= OnCaptureStateChanged;
        _observedMouse = Wolf.MouseTracker;
        _observedMouse.CaptureStateChanged += OnCaptureStateChanged;
    }

    private void OnCaptureStateChanged()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Console.WriteLine("[APP] Component initialized");

        try
        {
            Console.WriteLine("[APP] Loading shader");

            var computeShader = await Http.GetStringAsync(
                "shaders/raycast.wgsl");

            var wallsShader = await Http.GetStringAsync(
                "shaders/walls.wgsl");

            var spritesShader = await Http.GetStringAsync(
                "shaders/sprites.wgsl");

            Console.WriteLine(
                $"[APP] Shader loaded");

            _canvasElement = new HTMLCanvasElement(_canvas);

            await ShowLoadingProgressAsync("Starting graphics…");
            await Renderer.InitializeAsync(_canvasElement, computeShader, wallsShader, spritesShader);

            var initialMap = OriginalMap;
            if (!string.IsNullOrWhiteSpace(RequestedMap))
            {
                if (!System.Text.RegularExpressions.Regex.IsMatch(RequestedMap, "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"))
                    throw new InvalidDataException("Invalid map name in URL.");
                initialMap = $"maps/{RequestedMap}.json";
            }
            await Wolf.SwitchMapAsync(_canvasElement, initialMap, _lifetime.Token, ShowLoadingProgressAsync);
            ObserveMouse();
            _selectedMap = initialMap;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = ex.ToString();

            Console.Error.WriteLine(
                $"[APP] Initialization failed: {ex}");

            StateHasChanged();
        }
        finally
        {
            _loading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SelectMapAsync(string mapPath)
    {
        if (_loading || _disposed || _canvasElement == null) return;
        _loading = true;
        _error = null;
        try
        {
            await Wolf.SwitchMapAsync(_canvasElement, mapPath, _lifetime.Token, ShowLoadingProgressAsync);
            ObserveMouse();
            _selectedMap = mapPath;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = $"Could not load map: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_observedMouse != null) _observedMouse.CaptureStateChanged -= OnCaptureStateChanged;
        _lifetime.Cancel();
        Wolf.Stop();
        _canvasElement?.Dispose();
        Console.WriteLine("[APP] Disposing");
    }
}
