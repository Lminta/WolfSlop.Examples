@page "/"
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using WolfNET.Game
@using WolfNET.Game.InputEvents
@using WolfNET.Graphics

@inject BlazorJSRuntime JS
@inject HttpClient Http

@inject RendererSettings Settings
@inject WebGpuRenderer  Renderer
@inject Wolf Wolf

@implements IDisposable

<canvas @ref="_canvas"
        width="@Settings.Width"
        height="@Settings.Height"
        style="--render-width: @Settings.Width; --render-height: @Settings.Height;"
        tabindex="0">
</canvas>

@if (_loading)
{
    <div class="loading-overlay" role="status" aria-live="polite" aria-atomic="true">
        <div class="loading-card">
            <div class="loading-spinner" aria-hidden="true"></div>
            <h1>Loading scene</h1>
            <p>@_loadingMessage</p>
        </div>
    </div>
}

<aside class="map-switcher" aria-label="Map selection">
    <nav aria-label="Maps">
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == GlassworksMap))"
                aria-pressed="@(_selectedMap == GlassworksMap ? "true" : "false")" @onclick="() => SelectMapAsync(GlassworksMap)">The Glassworks</button>
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == OriginalMap))"
                aria-pressed="@(_selectedMap == OriginalMap ? "true" : "false")" @onclick="() => SelectMapAsync(OriginalMap)">The Brickyard</button>
        <button type="button" disabled="@(_loading || (!_errorPresent && _selectedMap == ShowcaseMap))"
                aria-pressed="@(_selectedMap == ShowcaseMap ? "true" : "false")" @onclick="() => SelectMapAsync(ShowcaseMap)">Showcase</button>
    </nav>
    <p role="status">@(_loading ? _loadingMessage : _observedMouse?.CaptureError ?? "Click the game to capture the mouse. Esc releases it.")</p>
    @if (_selectedMap == GlassworksMap)
    {
        <p>Explore an abandoned botanical station. Circle the central glasshouse through the potting room and pump room, or discover the maintenance shortcut.</p>
    }
    @if (_selectedMap == ShowcaseMap)
    {
        <ul class="showcase-guide">
            <li><strong>Top right:</strong> a compact missing-texture room just north of spawn. Pink is intentional.</li>
            <li><strong>Top left:</strong> lanes from left: clear path, invisible barrier, walk-through wall, solid wall. All have textured floors and ceilings.</li>
            <li><strong>Bottom right:</strong> props and a barrel pyramid are grouped on the west side. The clear east side has two jumpable rows of four columns at 0.4 scale near (9,20), with room to approach and land.</li>
            <li><strong>Obstacle corridor:</strong> enter through (24,11) from the independent-flags gallery. Follow the loop, alternating Space to jump and Alt to crouch.</li>
            <li><strong>Crouch test:</strong> hold Alt to pass under the ceiling-mounted columns at (9,16). Release after clearing them to stand.</li>
            <li><strong>Bottom left:</strong> floor and ceiling checkerboards and four wall faces around the pillar at (18,17).</li>
            <li><strong>Doors:</strong> face the steel door at (18,12) or glass door at (24,18) from a neighboring tile and press F to open or close.</li>
            <li><strong>Far left annex:</strong> enter from the materials gallery to compare a mesh ceiling with open sky. Walk around the enlarged car at (30,18) to see its eight directional views.</li>
        </ul>
    }
    @if (_selectedMap == OriginalMap)
    {
        <p>Explore the old motor depot. Beyond the gatehouse, the covered arcade leads to the courtyard and loading bays. The service passage offers a shorter way to the motor yard.</p>
    }
    <p class="controls-hint">W/S forward/back &middot; A/D strafe &middot; Mouse look &middot; Space jump &middot; Alt crouch &middot; V camera &middot; F interact &middot; Esc release</p>
</aside>

@if (_error != null)
{
    <pre class="game-error">@_error</pre>
}
