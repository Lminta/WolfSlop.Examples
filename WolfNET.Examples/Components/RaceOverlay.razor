@using WolfNET.Engine.World
@using System.Globalization
@implements IDisposable

@if (_state is { } race)
{
    @if (race.CountdownNumber is { } number)
    {
        <div class="race-countdown @(_paused ? "is-paused" : null)" role="status" aria-live="assertive">
            <span @key="number" class="race-countdown-number">@number</span>
        </div>
    }
    else if (race.ShowGo && race.Phase == RacePhase.Racing)
    {
        <div class="race-countdown @(_paused ? "is-paused" : null)" role="status"><span class="race-countdown-number race-go">GO</span></div>
    }
    else if (race.Phase == RacePhase.Finished)
    {
        <div class="race-results-overlay">
            <section class="race-results" role="dialog" aria-modal="true" aria-labelledby="race-results-title">
                <h1 id="race-results-title">Race finished!</h1>
                <p class="race-result-total">Total <strong>@Time(race.TotalMilliseconds)</strong></p>
                <table class="race-standings">
                    <thead><tr><th>Place</th><th>Driver</th><th>Time</th></tr></thead>
                    <tbody>
                        @foreach (var standing in race.Standings)
                        {
                            <tr class="@(standing.IsPlayer ? "race-player-result" : null)">
                                <td>@standing.Place</td><th scope="row">@standing.Name</th>
                                <td>@Time(standing.Status.TotalMilliseconds)
                                    @if (!standing.Status.Finished)
                                    {
                                        <small>Racing &middot; @standing.Status.CompletedLaps/@race.TotalLaps laps</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <table class="race-lap-results">
                    <thead><tr><th>Lap</th><th>You</th>
                        @for (var rival = 0; rival < race.Opponents.Count; rival++)
                        {
                            <th>@(rival == 0 ? "Blue car" : "Green car")</th>
                        }
                    </tr></thead>
                    <tbody>
                        @for (var i = 0; i < race.LapTimes.Count; i++)
                        {
                            <tr><th scope="row">@(i + 1)</th><td>@Time(race.LapTimes[i])</td>
                                @foreach (var rival in race.Opponents)
                                {
                                    <td>@(rival.LapTimes.Count > i ? Time(rival.LapTimes[i]) : "\u2014")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <button @ref="_restartButton" type="button" @onclick="OnRestart">Restart race</button>
            </section>
        </div>
    }
}

@code {
    [CascadingParameter] public Wolf Wolf { get; set; } = null!;
    [Parameter] public EventCallback OnRestart { get; set; }
    private RaceStatus? _state;
    private bool _disposed;
    private bool _paused;
    private bool _focusedResults;
    private ElementReference _restartButton;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusedResults && _state?.Phase == RacePhase.Finished)
        {
            _focusedResults = true;
            await _restartButton.FocusAsync();
        }
    }

    private static string Time(double milliseconds)
    {
        var centiseconds = (long)(milliseconds / 10);
        return string.Create(CultureInfo.InvariantCulture, $"{centiseconds / 6000}:{centiseconds / 100 % 60:00}.{centiseconds % 100:00}");
    }

    protected override void OnInitialized()
    {
        _state = Wolf.RaceState;
        _paused = Wolf.DrivingState?.Paused == true;
        Wolf.RaceStateChanged += OnRaceStateChanged;
        Wolf.DrivingStateChanged += OnDrivingStateChanged;
    }

    private void OnDrivingStateChanged(DrivingViewState state)
    {
        if (_disposed || _paused == state.Paused) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _paused = state.Paused;
            StateHasChanged();
        });
    }

    private void OnRaceStateChanged(RaceStatus state)
    {
        if (_disposed || _state == state) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _state = state;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Wolf.RaceStateChanged -= OnRaceStateChanged;
        Wolf.DrivingStateChanged -= OnDrivingStateChanged;
    }
}
